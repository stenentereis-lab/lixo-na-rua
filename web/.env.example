# Copie para .env e ajuste os valores.
# Variaveis do frontend precisam do prefixo VITE_ para o Vite
# expor ao browser. Nunca coloque segredo aqui: tudo que tem
# VITE_ vai parar no bundle publico.

VITE_API_URL=http://localhost:3000
# Opcional: link oficial liberado após uma inscrição beta bem-sucedida.
VITE_BETA_APK_URL=https://exemplo.com/Lixo-na-Rua-Beta.apk
