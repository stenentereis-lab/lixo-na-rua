# Copie para .env e ajuste os valores.
# O .env real nunca vai para o repositorio.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lixo_na_rua
DB_USER=postgres
DB_PASSWORD=postgres123

# Troque por um valor aleatorio longo em producao
JWT_SECRET=dev_secret_change_in_prod_12345
JWT_EXPIRY=7d

# Origens liberadas no CORS, separadas por virgula
# 3001 = web (Vite) | 8081 e 19006 = Expo
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:19006

# ---------- armazenamento de fotos ----------
# local = disco em backend/uploads (padrao em desenvolvimento)
# s3    = S3 ou compativel (producao) — ver docs/DEPLOY.md
STORAGE_DRIVER=local

# Tamanho maximo de imagem, em bytes (padrao 10 MB)
MAX_FILE_SIZE=10485760

# So necessarios com STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Vazio = AWS. Preenchido = Cloudflare R2, Backblaze B2, Spaces, MinIO...
S3_ENDPOINT=
# Dominio proprio ou CDN na frente do bucket
S3_PUBLIC_URL=

# Mapas: nao usado. O web usa Leaflet + OpenStreetMap, sem chave.
# MAPBOX_TOKEN=
