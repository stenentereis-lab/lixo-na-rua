{
  "name": "lixo-na-rua-backend",
  "version": "1.0.0",
  "description": "Backend para app de denúncia de lixo na rua",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node migrations/run.js",
    "set-role": "node scripts/set-role.js",
    "test": "jest --testPathIgnorePatterns tests/integration",
    "test:integration": "jest tests/integration --runInBand",
    "test:watch": "jest --testPathIgnorePatterns tests/integration --watch",
    "test:coverage": "jest --testPathIgnorePatterns tests/integration --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ]
  },
  "keywords": [
    "lixo",
    "denuncia",
    "gis"
  ],
  "author": "Aeroambiental",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pg-mem": "^2.8.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  }
}
