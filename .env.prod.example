# Producao — copie para .env.prod e preencha.
# O .env.prod NUNCA vai para o repositorio (esta no .gitignore).
#
# Passo a passo para obter cada valor: docs/DEPLOY.md

# ---------- banco ----------
DB_NAME=lixo_na_rua
DB_USER=lixo_app
# Gere: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=

# ---------- autenticacao ----------
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# O backend recusa subir em producao se este valor for o de desenvolvimento.
JWT_SECRET=
JWT_EXPIRY=7d

# ---------- rede ----------
# Origem do site no Cloudflare Pages. Sem espacos, so https.
# Inclua tambem o dominio *.pages.dev enquanto o dominio proprio nao propaga.
CORS_ORIGIN=https://lixonarua.org,https://lixo-na-rua.pages.dev

# Token do tunel: Cloudflare Zero Trust > Networks > Tunnels > seu tunel
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- fotos no Cloudflare R2 ----------
STORAGE_DRIVER=s3

# Nome do bucket criado em R2
S3_BUCKET=lixo-na-rua-fotos
# R2 usa "auto" como regiao
S3_REGION=auto
# R2 > Manage R2 API Tokens > Create API Token (permissao: Object Read & Write)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 > seu bucket > Settings > S3 API  (troque <account-id>)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Dominio publico do bucket: R2 > Settings > Public access > Connect domain
S3_PUBLIC_URL=https://fotos.lixonarua.org

# Tamanho maximo de imagem, em bytes (padrao 10 MB)
MAX_FILE_SIZE=10485760
