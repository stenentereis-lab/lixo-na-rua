# Producao — copie para .env.prod e preencha.
# O .env.prod NUNCA vai para o repositorio (esta no .gitignore).

# ---------- banco ----------
DB_NAME=lixo_na_rua
DB_USER=lixo_app
# Gere uma senha longa e aleatoria. Nao reaproveite a de desenvolvimento.
DB_PASSWORD=

# ---------- autenticacao ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# O backend recusa subir em producao se este valor for o de desenvolvimento.
JWT_SECRET=
JWT_EXPIRY=7d

# ---------- rede ----------
# Origens do frontend, separadas por virgula. Sem espacos.
CORS_ORIGIN=https://lixonarua.org
API_PORT=3000

# ---------- armazenamento de fotos ----------
# local = disco do container (as fotos somem a cada deploy). Nao use em producao.
STORAGE_DRIVER=s3

S3_BUCKET=lixo-na-rua-fotos
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Vazio = AWS S3. Preenchido = provedor compativel:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2    https://s3.<regiao>.backblazeb2.com
#   DO Spaces       https://<regiao>.digitaloceanspaces.com
S3_ENDPOINT=

# Dominio publico ou CDN na frente do bucket. Vazio = URL bruta do provedor.
S3_PUBLIC_URL=

# Tamanho maximo de imagem, em bytes (padrao 10 MB)
MAX_FILE_SIZE=10485760
