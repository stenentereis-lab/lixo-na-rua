{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "community": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "beta",
        "BETA_API_URL": "https://api-teste-lixo.brconsultorias.com"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
