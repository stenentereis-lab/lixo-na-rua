{
  "expo": {
    "name": "Lixo na Rua",
    "slug": "lixo-na-rua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.lixonarua.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.lixonarua.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Lixo na Rua precisa de acesso à câmera"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Lixo na Rua precisa de acesso à localização"
        }
      ]
    ]
  }
}
